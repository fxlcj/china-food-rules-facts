    },
    {
      "id": 2,
      "topic": "ordering",
      "claim": "A restaurant must put up an anti-waste sign in a prominent spot or have staff prompt diners to order the right amount.",
      "figure": "prominent anti-waste sign / staff prompt",
      "source_url": "http://npc.gov.cn/c2/c30834/202104/t20210429_311300.html",
      "checked_on": "2026-11-10",
